# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# ── Redis (BullMQ + cache) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Business rules ─────────────────────────────────────────────
# Days before expiry to raise an expiring-batch alert
EXPIRY_ALERT_THRESHOLD_DAYS=30
# Cron for the hourly low-stock scan (BullMQ repeatable)
LOW_STOCK_CRON="0 * * * *"
# Cron for the daily expiring-batch scan
EXPIRY_CRON="0 6 * * *"
# Default valuation method when a product does not set one: FIFO | WEIGHTED_AVERAGE
DEFAULT_VALUATION_METHOD=WEIGHTED_AVERAGE
