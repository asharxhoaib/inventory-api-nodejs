// Inventory Management API — Prisma schema
// FUNDAMENTAL RULE: stock quantities are never stored as a mutable column.
// The physical stock of a variant in a warehouse is SUM(StockMovement.quantity).
// Reserved stock is SUM(Reservation.quantity) for ACTIVE reservations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UnitOfMeasure {
  PIECE
  KG
  LITER
  METER
  BOX
}

enum MovementType {
  RECEIVE
  DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum ReferenceType {
  PO
  SO
  MANUAL
  STOCK_TAKE
  TRANSFER
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELED
}

enum StockTakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

enum AlertType {
  LOW_STOCK
  EXPIRING_BATCH
  OUT_OF_STOCK
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum PaymentTerms {
  NET15
  NET30
  NET60
  NET90
  PREPAID
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String            @id @default(uuid())
  name            String
  sku             String            @unique
  barcode         String?           @unique
  description     String?
  categoryId      String?           @map("category_id")
  category        Category?         @relation(fields: [categoryId], references: [id])
  unitOfMeasure   UnitOfMeasure     @default(PIECE) @map("unit_of_measure")
  weight          Decimal?          @db.Decimal(12, 3)
  dimensions      Json?
  reorderPoint    Int               @default(0) @map("reorder_point")
  reorderQuantity Int               @default(0) @map("reorder_quantity")
  valuationMethod ValuationMethod   @default(WEIGHTED_AVERAGE) @map("valuation_method")
  isActive        Boolean           @default(true) @map("is_active")
  variants        ProductVariant[]
  suppliers       ProductSupplier[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String          @unique
  barcode        String?         @unique
  attributes     Json?
  isActive       Boolean         @default(true) @map("is_active")
  movements      StockMovement[]
  reservations   Reservation[]
  batches        Batch[]
  poItems        POItem[]
  stockTakeItems StockTakeItem[]
  alerts         Alert[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────
// Warehouses
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id           String          @id @default(uuid())
  name         String
  code         String          @unique
  address      Json?
  capacity     Int?
  isActive     Boolean         @default(true) @map("is_active")
  movements    StockMovement[]
  reservations Reservation[]
  batches      Batch[]
  purchaseOrders PurchaseOrder[]
  stockTakes   StockTake[]
  alerts       Alert[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("warehouses")
}

// ─────────────────────────────────────────────────────────────
// Stock movements — the single source of truth for quantities
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id            String         @id @default(uuid())
  variantId     String         @map("variant_id")
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  warehouseId   String         @map("warehouse_id")
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  type          MovementType
  // Signed quantity: positive adds stock, negative removes it.
  quantity      Int
  referenceType ReferenceType  @default(MANUAL) @map("reference_type")
  referenceId   String?        @map("reference_id")
  batchId       String?        @map("batch_id")
  batch         Batch?         @relation(fields: [batchId], references: [id])
  unitCost      Decimal?       @db.Decimal(14, 4) @map("unit_cost")
  reason        String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([variantId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@index([batchId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// Reservations — affect available stock, not physical stock
// ─────────────────────────────────────────────────────────────

model Reservation {
  id          String            @id @default(uuid())
  variantId   String            @map("variant_id")
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  warehouseId String            @map("warehouse_id")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  referenceType ReferenceType   @default(SO) @map("reference_type")
  referenceId String?           @map("reference_id")
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([variantId, warehouseId, status])
  @@index([referenceType, referenceId])
  @@map("reservations")
}

// ─────────────────────────────────────────────────────────────
// Batches / lot tracking
// ─────────────────────────────────────────────────────────────

model Batch {
  id              String          @id @default(uuid())
  variantId       String          @map("variant_id")
  variant         ProductVariant  @relation(fields: [variantId], references: [id])
  warehouseId     String          @map("warehouse_id")
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  batchNumber     String          @map("batch_number")
  manufactureDate DateTime?       @map("manufacture_date")
  expiryDate      DateTime?       @map("expiry_date")
  quantityRemaining Int           @default(0) @map("quantity_remaining")
  movements       StockMovement[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([variantId, warehouseId, batchNumber])
  @@index([expiryDate])
  @@map("batches")
}

// ─────────────────────────────────────────────────────────────
// Suppliers & purchase orders
// ─────────────────────────────────────────────────────────────

model Supplier {
  id             String            @id @default(uuid())
  name           String
  code           String            @unique
  email          String?
  phone          String?
  address        Json?
  paymentTerms   PaymentTerms      @default(NET30) @map("payment_terms")
  leadTimeDays   Int               @default(7) @map("lead_time_days")
  isActive       Boolean           @default(true) @map("is_active")
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("suppliers")
}

model ProductSupplier {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priority   Int      @default(1)
  supplierSku String? @map("supplier_sku")
  unitPrice  Decimal? @db.Decimal(14, 4) @map("unit_price")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  poNumber         String              @unique @map("po_number")
  supplierId       String              @map("supplier_id")
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId      String              @map("warehouse_id")
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?           @map("expected_delivery")
  receivedAt       DateTime?           @map("received_at")
  notes            String?
  totalAmount      Decimal             @default(0) @db.Decimal(16, 4) @map("total_amount")
  items            POItem[]
  createdBy        String?             @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model POItem {
  id               String         @id @default(uuid())
  poId             String         @map("po_id")
  purchaseOrder    PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variantId        String         @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  orderedQuantity  Int            @map("ordered_quantity")
  receivedQuantity Int            @default(0) @map("received_quantity")
  unitPrice        Decimal        @db.Decimal(14, 4) @map("unit_price")

  @@index([poId])
  @@map("po_items")
}

// ─────────────────────────────────────────────────────────────
// Stock takes / audit
// ─────────────────────────────────────────────────────────────

model StockTake {
  id          String          @id @default(uuid())
  warehouseId String          @map("warehouse_id")
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  status      StockTakeStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now()) @map("started_at")
  completedAt DateTime?       @map("completed_at")
  createdBy   String?         @map("created_by")
  items       StockTakeItem[]

  @@index([warehouseId, status])
  @@map("stock_takes")
}

model StockTakeItem {
  id               String         @id @default(uuid())
  stockTakeId      String         @map("stock_take_id")
  stockTake        StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variantId        String         @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  expectedQuantity Int            @map("expected_quantity")
  actualQuantity   Int?           @map("actual_quantity")
  difference       Int?
  notes            String?

  @@unique([stockTakeId, variantId])
  @@index([stockTakeId])
  @@map("stock_take_items")
}

// ─────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────

model Alert {
  id          String         @id @default(uuid())
  type        AlertType
  variantId   String?        @map("variant_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String?        @map("warehouse_id")
  warehouse   Warehouse?     @relation(fields: [warehouseId], references: [id])
  message     String
  status      AlertStatus    @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([variantId, warehouseId])
  @@map("alerts")
}
